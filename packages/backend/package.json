{
  "name": "@skills-runtime/backend",
  "version": "0.1.0",
  "description": "Skills Runtime Backend with Hono",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "@opencode-ai/sdk": "^1.1.25",
    "@skills-runtime/shared": "workspace:*",
    "eventsource": "^4.1.0",
    "hono": "^4.6.0",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "undici": "^7.18.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/eventsource": "^3.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
